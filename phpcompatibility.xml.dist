<?xml version="1.0"?>
<ruleset name="PHPCompatibility">
    <description>PHP version compatibility check</description>

    <file>src</file>

    <config name="testVersion" value="8.2-"/>

    <rule ref="PHPCompatibility">
        <!-- Provided by symfony/polyfill-mbstring on PHP < 8.4 -->
        <exclude name="PHPCompatibility.FunctionUse.NewFunctions.mb_trimFound"/>
    </rule>
</ruleset>
